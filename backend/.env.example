# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Supabase project URL and SECRET (server-side) key.
# Keep the secret key on the server only - never put it in front-end code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# Public (publishable / anon) key from the same Supabase page. It lets Supabase send
# the confirmation email when an employee signs up. Safe to use here, it is not secret.
# Leave it out to skip confirmation emails.
SUPABASE_ANON_KEY=your-publishable-key

PORT=3000

# Where the app is reached. Links in emails send people back here.
# Use your real web address once deployed (for example https://shop.example.com).
SITE_URL=http://localhost:3000

# Comma-separated emails allowed to use the API (recommended).
# If empty, any signed-in Supabase user is allowed.
ADMIN_EMAILS=admin@example.com

# New employee sign-ups are locked until an admin enables them on the Employees page.
# Set to "false" to let people sign in straight after registering.
REQUIRE_APPROVAL=true

# Extra browser origins allowed to call the API (comma-separated).
# Any http://localhost or http://127.0.0.1 port is already allowed outside production.
CORS_ORIGINS=

# Set to "production" when deployed (then only CORS_ORIGINS are allowed).
NODE_ENV=development
